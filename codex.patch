diff --git a/composables/useDelayedLoading.ts b/composables/useDelayedLoading.ts
new file mode 100644
index 0000000000000000000000000000000000000000..7449ba346dc8078b8f82110a19e25ce49443ab8f
--- /dev/null
+++ b/composables/useDelayedLoading.ts
@@ -0,0 +1,19 @@
+import type { Ref } from 'vue'
+
+export const useDelayedLoading = (pending: Ref<boolean>, delay = 800) => {
+  const showDelayed = ref(false)
+
+  const startTimer = () => {
+    showDelayed.value = false
+    if (!pending.value) return
+    setTimeout(() => {
+      if (pending.value) {
+        showDelayed.value = true
+      }
+    }, delay)
+  }
+
+  watch(pending, () => startTimer(), { immediate: true })
+
+  return { showDelayed }
+}
