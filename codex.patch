+<template>
+  <section v-if="pending" class="animal-detail">
+    <LoadingGrid :items="1" :show-delayed="showDelayed" />
+  </section>
+
+  <section v-else-if="error" class="animal-detail">
+    <ErrorState @retry="refresh" />
+  </section>
